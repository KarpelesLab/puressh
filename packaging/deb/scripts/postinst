#!/bin/sh
# puressh-server postinst: take over from openssh-server.
set -e

# Was SSH enabled at boot before we got here, as a service (20.04/22.04) or
# through ssh.socket (24.04)? The enablement symlinks survive openssh-server's
# removal. We start and enable ssh.service only in that case, so a host where
# the administrator disabled SSH stays that way.
ssh_wanted() {
	[ -e /etc/systemd/system/multi-user.target.wants/ssh.service ] ||
		[ -L /etc/systemd/system/multi-user.target.wants/ssh.service ] ||
		[ -L /etc/systemd/system/sockets.target.wants/ssh.socket ] ||
		[ -L /etc/systemd/system/sshd.service ]
}

if [ "$1" = "configure" ]; then
	/usr/lib/puressh/sshd-prepare

	# Check the configuration with the new daemon *before* touching the
	# running one: if it is rejected, the SSH daemon that is running now
	# keeps serving, so the machine stays reachable.
	SSHD_OPTS=
	[ -r /etc/default/ssh ] && . /etc/default/ssh
	# shellcheck disable=SC2086
	if ! check=$(/usr/sbin/sshd -t $SSHD_OPTS 2>&1); then
		cat >&2 <<MSG

puressh-server: /usr/sbin/sshd rejected the SSH configuration:

$check

The SSH daemon that was already running has NOT been stopped and keeps
serving connections, but it will not come back after a restart or reboot.
Fix the configuration (check with: sshd -t), then run:
    dpkg --configure -a && systemctl restart ssh

MSG
		exit 1
	fi

	if [ -d /run/systemd/system ]; then
		wanted=
		ssh_wanted && wanted=1
		# openssh-server's postrm masks ssh.service and ssh.socket on 20.04
		# and 22.04; ssh.service is ours now.
		deb-systemd-helper unmask ssh.service >/dev/null || true
		deb-systemd-helper unmask ssh.socket >/dev/null || true
		# Socket activation (24.04's default) is not used: our daemon
		# listens on its own. Drop the leftover socket unit.
		systemctl stop ssh.socket >/dev/null 2>&1 || true
		deb-systemd-helper purge ssh.socket >/dev/null 2>&1 || true
		rm -f /etc/systemd/system/sockets.target.wants/ssh.socket
		systemctl daemon-reload || true

		if [ -n "$wanted" ]; then
			# SSH was enabled before: keep it enabled.
			deb-systemd-helper enable ssh.service >/dev/null || true
			systemctl -q is-enabled ssh.service 2>/dev/null ||
				systemctl enable ssh.service
		elif [ -z "$2" ] && ! deb-systemd-helper debian-installed ssh.service; then
			# First install on a host that never had an SSH server
			# package: enable it, as openssh-server would.
			deb-systemd-helper enable ssh.service >/dev/null || true
		else
			# An administrator disabled SSH: respect that.
			deb-systemd-helper update-state ssh.service >/dev/null || true
		fi
		if systemctl -q is-enabled ssh.service 2>/dev/null ||
			systemctl -q is-active ssh.service 2>/dev/null; then
			# KillMode=process: only the old listener is replaced, open
			# sessions survive.
			systemctl restart ssh.service
		fi
	fi
fi

exit 0
