#!/bin/sh
# puressh-server postrm.
set -e

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "$1" = "purge" ]; then
	# The host keys and /etc/ssh/sshd_config are left in place: they belong
	# to the machine (and to whichever SSH server is installed next), not to
	# this package. Only our backup copy goes.
	rm -rf /var/lib/puressh
	if [ -x /usr/bin/deb-systemd-helper ]; then
		deb-systemd-helper purge ssh.service >/dev/null || true
		deb-systemd-helper purge sshd-keygen.service >/dev/null || true
	fi
fi

exit 0
